POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=automlops
POSTGRES_USER=automlops
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+psycopg2://automlops:changeme_in_production@postgres:5432/automlops

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=automlops_churn
MLFLOW_MODEL_NAME=churn_classifier
MLFLOW_ARTIFACT_ROOT=./mlruns

INFERENCE_API_HOST=0.0.0.0
INFERENCE_API_PORT=8000
INFERENCE_MODEL_STAGE=Production
MODEL_LOAD_TIMEOUT_SECONDS=30

AIRFLOW_HOST=http://airflow:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_RETRAIN_DAG_ID=retrain_pipeline
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://automlops:changeme_in_production@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=change_me_generate_with_fernet_key_generate
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_secret_key

DRIFT_REFERENCE_DATA_PATH=/app/data/reference/reference.parquet
DRIFT_WINDOW_SIZE=1000
DRIFT_CHECK_INTERVAL_SECONDS=300
DRIFT_SHARE_THRESHOLD=0.3
DRIFT_PVALUE_THRESHOLD=0.05

VALIDATION_AUC_DELTA_THRESHOLD=0.005
VALIDATION_SIGNIFICANCE_LEVEL=0.05

PROMETHEUS_PORT=9090

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO
ENV=development
PROJECT_NAME=automlops