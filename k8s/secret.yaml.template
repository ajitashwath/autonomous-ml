# ============================================================
# secret.yaml.template — DO NOT COMMIT REAL VALUES
#
# How to use:
#   1. Copy this file:  cp secret.yaml.template secret.yaml
#   2. Replace <base64-encoded-value> with actual base64 values:
#      echo -n "my_password" | base64
#   3. Apply: kubectl apply -f secret.yaml
#   4. NEVER commit secret.yaml (it is in .gitignore)
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: automlops-secrets
  namespace: automlops
type: Opaque
data:
  # postgresql+psycopg2://user:password@postgres-service:5432/automlops
  DATABASE_URL: <base64-encoded-database-url>
  POSTGRES_PASSWORD: <base64-encoded-postgres-password>
  POSTGRES_USER: <base64-encoded-postgres-user>
  POSTGRES_DB: <base64-encoded-db-name>

  # MLflow
  MLFLOW_TRACKING_URI: <base64-encoded-mlflow-uri>

  # Airflow
  AIRFLOW_USERNAME: <base64-encoded-airflow-user>
  AIRFLOW_PASSWORD: <base64-encoded-airflow-password>
  AIRFLOW_FERNET_KEY: <base64-encoded-fernet-key>
  AIRFLOW_SECRET_KEY: <base64-encoded-webserver-secret-key>

  # Alerting (optional)
  SLACK_WEBHOOK_URL: <base64-encoded-slack-webhook-url>

  # Grafana
  GRAFANA_ADMIN_PASSWORD: <base64-encoded-grafana-password>
